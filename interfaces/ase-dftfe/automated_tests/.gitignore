# Scheduler job logs and per-job scratch. These were committed once by a broad
# `git add -A` after a `git rm --cached` (which leaves the file on disk, so any
# later add re-stages it). 2.9 MB of run output reached origin that way.
*.o[0-9]*
*.e[0-9]*
*.out
gpu_shims_*/

